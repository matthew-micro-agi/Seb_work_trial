+/**
+ * cdns_csi2rx_get_frame_nb - Frame number of the last Frame Start packet on a VC
+ * @subdev: point to &struct v4l2_subdev
+ * @vc: virtual channel
+ * @nb: the 16-bit frame number from the CSI-2 Frame Start short packet
+ *
+ * Valid while a stream whose monitor watches @vc is running.
+ *
+ * Return: 0 on success, -ENOENT if no running stream monitors @vc.
+ */
+int cdns_csi2rx_get_frame_nb(struct v4l2_subdev *subdev, unsigned int vc, u16 *nb)
+{
+	struct csi2rx_priv *csi2rx = v4l2_subdev_to_csi2rx(subdev);
+	unsigned int i;
+
+	for (i = 0; i < csi2rx->max_streams; i++) {
+		if (csi2rx->monitor_vc[i] != (int)vc)
+			continue;
+		*nb = FIELD_GET(CSI2RX_STREAM_MONITOR_FRAME_NB_MASK,
+				readl(csi2rx->base + CSI2RX_STREAM_MONITOR_FRAME_REG(i)));
+		return 0;
+	}
+
+	return -ENOENT;
+}
+EXPORT_SYMBOL(cdns_csi2rx_get_frame_nb);
