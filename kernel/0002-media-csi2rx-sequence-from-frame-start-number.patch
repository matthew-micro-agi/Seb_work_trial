+/*
+ * The V4L2 sequence number should count every frame the sensor produced, so a
+ * frame lost before this DMA completion leaves a hole. The Cadence bridge keeps
+ * the frame number of the last Frame Start packet per monitored virtual
+ * channel. When the sensor numbers its frames (the number changes), the
+ * sequence follows those numbers, wrap included; a sensor that sends a constant
+ * number falls back to counting completed buffers, as before.
+ *
+ * The register is read after the DMA completion, so if the next Frame Start
+ * arrives first (short vertical blanking, late callback) one buffer reads one
+ * too high and the next reads the same number again; the sequence then repeats
+ * once instead of drifting.
+ */
+static u32 ti_csi2rx_sequence(struct ti_csi2rx_ctx *ctx)
+{
+	u32 seq = ctx->sequence++;
+	u16 nb;
+
+	if (cdns_csi2rx_get_frame_nb(ctx->csi->source, ctx->vc, &nb))
+		return seq;
+
+	if (ctx->nb_seen) {
+		ctx->nb_seq += (s16)(nb - ctx->nb_last);
+		if (ctx->nb_seq)
+			ctx->nb_live = true;
+	}
+	ctx->nb_last = nb;
+	ctx->nb_seen = true;
+
+	return ctx->nb_live ? ctx->nb_seq : seq;
+}
+
 static void ti_csi2rx_dma_callback(void *param)
 {
 	struct ti_csi2rx_buffer *buf = param;
@@ -798,12 +837,8 @@
